# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://ala_user:ala_password@localhost:5432/ai_learning_agent?schema=public

# ── Redis / BullMQ ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers ────────────────────────────────────────
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

AI_PROVIDER=openai
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_MS=120000

# ── Processing ──────────────────────────────────────────
TEMP_STORAGE_DIR=./temp
MAX_TRANSCRIPTION_RETRIES=2
AUDIO_CHUNK_TARGET_MB=24
AUDIO_CHUNK_OVERLAP_SECONDS=3

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Auth (scaffolded for future milestone) ─────────────
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=7d

# ── Milestone 2: RAG chat ────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75
RAG_MAX_CONTEXT_CHARS=12000

CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1200

DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ── Milestone 3: Interview Engine ────────────────────────
INTERVIEW_QUICK_DEFAULT_QUESTIONS=5
INTERVIEW_MAX_QUESTIONS=20
INTERVIEW_TEMPERATURE=0.4
INTERVIEW_MAX_TOKENS=600

ANSWER_EVALUATION_TEMPERATURE=0.2
ANSWER_EVALUATION_MAX_TOKENS=500

# ── Milestone 5: Weak Area Detection & Revision Planner ──
REVISION_LOW_SCORE_THRESHOLD=6
REVISION_MAX_WEAK_TOPICS=5
REVISION_PLAN_TEMPERATURE=0.3
REVISION_PLAN_MAX_TOKENS=700

# ── Milestone 6: Intelligent Learning Agent ──────────────
LEARNING_AGENT_INTENT_TEMPERATURE=0
LEARNING_AGENT_INTENT_MAX_TOKENS=50
