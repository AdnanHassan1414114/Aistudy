# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:3000

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://ala_user:ala_password@localhost:5432/ai_learning_agent?schema=public

# ── Redis / BullMQ ──────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers ────────────────────────────────────────
# Which provider generates chat/notes/interview text.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# "groq" or "openai" — this is the value that's actually live in this
# project's own .env right now. Only one AI_PROVIDER line should ever
# exist in this file; if you see it defined twice, the LAST one silently
# wins and the other becomes dead config — that bug bit this project once.
AI_PROVIDER=groq
AI_REQUEST_TIMEOUT_MS=120000

# Which provider generates embeddings for RAG search. IMPORTANT: if you
# change this, EMBEDDING_DIMENSIONS below MUST match what that provider
# outputs, AND prisma/schema.prisma's `vector(768)` column definition
# must match too — a mismatch fails silently until the first embedding
# insert, with a confusing Postgres error.
#   gemini + text-embedding-004  -> 768 dimensions
#   openai + text-embedding-3-small -> 1536 dimensions (requires a schema
#     migration to `vector(1536)` if you switch to this)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# ── Processing ──────────────────────────────────────────
TEMP_STORAGE_DIR=./temp
MAX_TRANSCRIPTION_RETRIES=2
AUDIO_CHUNK_TARGET_MB=24
AUDIO_CHUNK_OVERLAP_SECONDS=3

# ── Download flow guards ──────────────────────────────────
MAX_VIDEO_DURATION_MINUTES=90
YT_DLP_METADATA_TIMEOUT_MS=30000
YT_DLP_DOWNLOAD_TIMEOUT_MS=600000

# ── Rate limiting ───────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Auth (scaffolded for future milestone) ─────────────
JWT_SECRET=change_me_dev_secret
JWT_EXPIRES_IN=7d

# ── Milestone 2: RAG chat ────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75
RAG_MAX_CONTEXT_CHARS=12000

CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=1200

DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

# ── Milestone 3: Interview Engine ────────────────────────
INTERVIEW_QUICK_DEFAULT_QUESTIONS=5
INTERVIEW_MAX_QUESTIONS=20
INTERVIEW_TEMPERATURE=0.4
INTERVIEW_MAX_TOKENS=600

ANSWER_EVALUATION_TEMPERATURE=0.2
ANSWER_EVALUATION_MAX_TOKENS=500

# ── Milestone 5: Weak Area Detection & Revision Planner ──
REVISION_LOW_SCORE_THRESHOLD=6
REVISION_MAX_WEAK_TOPICS=5
REVISION_PLAN_TEMPERATURE=0.3
REVISION_PLAN_MAX_TOKENS=700

# ── Milestone 6: Intelligent Learning Agent ──────────────
LEARNING_AGENT_INTENT_TEMPERATURE=0
LEARNING_AGENT_INTENT_MAX_TOKENS=50